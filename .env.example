# Fournir les valeurs dans l'environnement du processus, sans commettre de secret.
# Ce fichier n'est pas chargé automatiquement.
ALLERGOLAB_DONNEES=donnees/allergenchipchallenge-data-corrected-final-hdh-sfa.csv
ALLERGOLAB_REGLAGES=configuration/modeles.toml
ALLERGOLAB_MODELE_ACTIF=false
# ALLERGYLAB_CLE : clé du fournisseur, ou fichier ~/.allergylab/cle existant.
# ALLERGOLAB_CLE_API : secret HTTP distinct, à définir pour protéger l'API.
# ALLERGOLAB_METADATA : fichier JSON de définitions validées par les chercheurs.
# ALLERGOLAB_RUNTIME : dossier SQLite local (runtime/ par défaut).

